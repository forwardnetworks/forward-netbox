/**
 * @intent Forward NetBox shared helpers
 * @description Shared NQE helpers for slug shaping and canonical manufacturer naming.
 */

manufacturer_name_overrides = [
  { vendor: Vendor.A10, name: "A10" },
  { vendor: Vendor.AMAZON, name: "Amazon" },
  { vendor: Vendor.ARISTA, name: "Arista" },
  { vendor: Vendor.ARUBA, name: "Aruba" },
  { vendor: Vendor.AVAYA, name: "Avaya" },
  { vendor: Vendor.AVI_NETWORKS, name: "Avi Networks" },
  { vendor: Vendor.AZURE, name: "Microsoft" },
  { vendor: Vendor.BLUECAT, name: "BlueCat" },
  { vendor: Vendor.BROCADE, name: "Brocade" },
  { vendor: Vendor.CHECKPOINT, name: "Check Point" },
  { vendor: Vendor.CISCO, name: "Cisco" },
  { vendor: Vendor.CITRIX, name: "Citrix" },
  { vendor: Vendor.CUMULUS, name: "Cumulus" },
  { vendor: Vendor.DELL, name: "Dell" },
  { vendor: Vendor.EDGE_CORE, name: "Edge Core" },
  { vendor: Vendor.EXTREME, name: "Extreme Networks" },
  { vendor: Vendor.F5, name: "F5" },
  { vendor: Vendor.FORCEPOINT, name: "Forcepoint" },
  { vendor: Vendor.FORTINET, name: "Fortinet" },
  { vendor: Vendor.GENERAL_DYNAMICS, name: "General Dynamics" },
  { vendor: Vendor.GOOGLE, name: "Google" },
  { vendor: Vendor.HP, name: "HPE" },
  { vendor: Vendor.HUAWEI, name: "Huawei" },
  { vendor: Vendor.JUNIPER, name: "Juniper" },
  { vendor: Vendor.LINUX_GENERIC, name: "Linux" },
  { vendor: Vendor.NOKIA, name: "Nokia" },
  { vendor: Vendor.PALO_ALTO_NETWORKS, name: "Palo Alto Networks" },
  { vendor: Vendor.PENSANDO, name: "Pensando" },
  { vendor: Vendor.PICA8, name: "Pica8" },
  { vendor: Vendor.RIVERBED, name: "Riverbed" },
  { vendor: Vendor.SILVER_PEAK, name: "Silver Peak" },
  { vendor: Vendor.SYMANTEC, name: "Symantec" },
  { vendor: Vendor.T128, name: "128T" },
  { vendor: Vendor.UNKNOWN, name: "Unknown" },
  { vendor: Vendor.VERSA, name: "Versa" },
  { vendor: Vendor.VIASAT, name: "Viasat" },
  { vendor: Vendor.VMWARE, name: "VMware" },
  { vendor: Vendor.ALKIRA, name: "Alkira" }
];

canonicalManufacturerOverride(vendor: Vendor) =
  max(
    foreach mapping in manufacturer_name_overrides
    where mapping.vendor == vendor
    select mapping.name
  );

export canonicalManufacturerName(vendor: Vendor) =
  if isPresent(canonicalManufacturerOverride(vendor))
  then canonicalManufacturerOverride(vendor)
  else replace(replace(toString(vendor), "Vendor.", ""), "_", " ");

export platformOsName(platform_os: String) =
  replace(platform_os, "OS.", "");

export isAciNxosVersion(platform_os: String, platform_os_version: String) =
  platformOsName(platform_os) == "NXOS"
  && (
    matches(platform_os_version, "14.*")
    || matches(platform_os_version, "15.*")
    || matches(platform_os_version, "16.*")
  );

export isApicPlatform(platform_os: String) =
  matches(toLowerCase(platformOsName(platform_os)), "*apic*");

export isCimcPlatform(platform_os: String) =
  matches(toLowerCase(platformOsName(platform_os)), "*cimc*");

export normalizePlatformName(platform_os: String, platform_os_version: String) =
  if isApicPlatform(platform_os)
  then "APIC"
  else if isCimcPlatform(platform_os)
  then "CIMC"
  else if matches(toLowerCase(platformOsName(platform_os)), "*nxos_aci*")
    || isAciNxosVersion(platform_os, platform_os_version)
  then "ACI"
  else platformOsName(platform_os);

export deviceIsApicController(device: Device) =
  isPresent(
    max(
      foreach command in device.outputs.commands
      where command.commandType == CommandType.CISCO_APIC_CONTROLLER_DETAIL
      select command.commandType
    )
  );

export deviceHasAciCommandOutputs(device: Device) =
  isPresent(
    max(
      foreach command in device.outputs.commands
      where command.commandType in [
        CommandType.CISCO_APIC_SWITCH,
        CommandType.CISCO_APIC_CONTROLLER_DETAIL,
        CommandType.CISCO_ACI_FABRIC_NODES,
        CommandType.CISCO_ACI_FABRIC_VRFS,
        CommandType.CISCO_ACI_NODE_TYPE,
        CommandType.CISCO_ACI_SPINE_INTERFACE_MODE,
        CommandType.CISCO_ACI_SPINE_IP_ENDPOINTS,
        CommandType.CISCO_ACI_SPINE_TUNNELS_NEXTHOP,
        CommandType.CISCO_ACI_TUNNELS_ENDPOINTS,
        CommandType.CISCO_ACI_ZONING_RULE,
        CommandType.CISCO_ACI_ZONING_FILTER,
        CommandType.CISCO_ACI_EPM_ENDPOINTS,
        CommandType.CISCO_APIC_VLAN_LEAF,
        CommandType.CISCO_APIC_EXT_L3OUT_INTERFACES,
        CommandType.CISCO_APIC_VLAN_STATUS_LEAF,
        CommandType.CISCO_APIC_VPC_MAP
      ]
      select command.commandType
    )
  );

export isApicControllerCommandOutputs(device: Device) =
  isPresent(
    max(
      foreach command in device.outputs.commands
      where command.commandType in [
        CommandType.CISCO_APIC_SWITCH,
        CommandType.CISCO_APIC_CONTROLLER_DETAIL
      ]
      select command.commandType
    )
  );

export isAciDevice(device: Device) =
  normalizePlatformName(
    toString(device.platform.os),
    if isPresent(device.platform.osVersion) then device.platform.osVersion else ""
  ) == "ACI"
  || (
    !isApicPlatform(toString(device.platform.os))
    && !isApicControllerCommandOutputs(device)
    && deviceHasAciCommandOutputs(device)
  );

export normalizeDevicePlatformName(device: Device) =
  if isApicPlatform(toString(device.platform.os)) || deviceIsApicController(device)
  then "APIC"
  else if isCimcPlatform(toString(device.platform.os))
  then "CIMC"
  else if isAciDevice(device)
  then "ACI"
  else normalizePlatformName(
    toString(device.platform.os),
    if isPresent(device.platform.osVersion) then device.platform.osVersion else ""
  );

export slugify(value: String) =
  replaceRegexMatches(
    replaceRegexMatches(
      replace(toLowerCase(value), "&", " and "),
      re`[^a-z0-9]+`,
      "-"
    ),
    re`^-+|-+$`,
    ""
  );

export slugifyNetboxModel(value: String) =
  slugify(
    replace(
      replace(
        replace(value, "+", " plus "),
        "/", " slash "
      ),
      ".", " dot "
    )
  );

// BEGIN site naming helpers (embedded verbatim by utilities/site_tag.py)
// The NetBox site a device belongs to. Forward knows a device by its location;
// NetBox sites are usually coarser (many Forward locations make up one data
// centre). A device tagged NetBox_Site_<name> is placed at the site <name>,
// whatever its location; an untagged device keeps its location, as before.
// Names are lowercased like every site name the sync creates. A device with more
// than one such tag takes the first alphabetically, so the answer never depends on
// tag order. See docs/02_Reference/site-tag-override.md.
export siteTagName(tag_names: List<String>) =
  min(
    foreach tag in tag_names
    where matches(tag, "NetBox_Site_*")
    where length(replace(tag, "NetBox_Site_", "")) > 0
    select replace(tag, "NetBox_Site_", "")
  );

export siteNameFor(tag_names: List<String>, location_name: String) =
  if isPresent(siteTagName(tag_names))
  then toLowerCase(siteTagName(tag_names))
  else if length(location_name) > 0
  then toLowerCase(location_name)
  else "unknown";

export deviceSiteName(device: Device) =
  siteNameFor(
    device.tagNames,
    if isPresent(device.locationName) then device.locationName else ""
  );

// Site mapping rules. The operator lists "devices at this Forward location, or
// with this Forward tag, go to this NetBox site" on the Forward source; the plugin
// sends the list with each rule's position as `rank`. A location pattern is a glob
// matched against the lowercased location, a tag is matched exactly. The lowest
// rank that matches wins. Precedence for a device: an explicit NetBox_Site_<name>
// tag, then the first matching rule, then the Forward location. See
// docs/02_Reference/site-tag-override.md.
export siteRuleMatches(
  rule: { kind: String, pattern: String, site: String, rank: Number },
  tag_names: List<String>,
  location_name: String
) =
  (rule.kind == "tag" && any(foreach tag in tag_names select tag == rule.pattern))
  || (rule.kind == "location"
    && length(location_name) > 0
    && matches(toLowerCase(location_name), toLowerCase(rule.pattern)));

export siteRuleRank(
  rules: List<{ kind: String, pattern: String, site: String, rank: Number }>,
  tag_names: List<String>,
  location_name: String
) =
  min(
    foreach rule in rules
    where siteRuleMatches(rule, tag_names, location_name)
    select rule.rank
  );

// The site of the lowest-ranked matching rule. A rule wins when it matches and no
// lower-ranked rule does; only matching rules pay for that comparison, so the cost
// follows how many rules match a device, not the square of how many are set.
export siteRuleSite(
  rules: List<{ kind: String, pattern: String, site: String, rank: Number }>,
  tag_names: List<String>,
  location_name: String
) =
  max(
    foreach rule in rules
    where siteRuleMatches(rule, tag_names, location_name)
    where !any(
      foreach other in rules
      where other.rank < rule.rank
      where siteRuleMatches(other, tag_names, location_name)
      select true
    )
    select rule.site
  );

export siteNameForRulesElse(
  rules: List<{ kind: String, pattern: String, site: String, rank: Number }>,
  tag_names: List<String>,
  location_name: String,
  fallback: String
) =
  if isPresent(siteTagName(tag_names))
  then toLowerCase(siteTagName(tag_names))
  else if isPresent(siteRuleSite(rules, tag_names, location_name))
  then toLowerCase(siteRuleSite(rules, tag_names, location_name))
  else if length(location_name) > 0
  then toLowerCase(location_name)
  else fallback;

export siteNameForRules(
  rules: List<{ kind: String, pattern: String, site: String, rank: Number }>,
  tag_names: List<String>,
  location_name: String
) =
  siteNameForRulesElse(rules, tag_names, location_name, "unknown");

export deviceSiteNameRules(
  device: Device,
  rules: List<{ kind: String, pattern: String, site: String, rank: Number }>
) =
  siteNameForRules(
    rules,
    device.tagNames,
    if isPresent(device.locationName) then device.locationName else ""
  );
// END site naming helpers
