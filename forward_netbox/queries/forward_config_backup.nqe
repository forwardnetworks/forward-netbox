/**
 * @intent Raw device configurations, exactly as Forward collected them
 * @description Backing store for the config-backup job: the running
 * configuration for each device this sync manages, written to the git data
 * source the operator selected.
 *
 * NOT a registered query map: the rows are file contents, not NetBox model
 * rows, so this never enters the workload/merge pipeline. The config-backup
 * post-sync job loads it directly and pages through it with a small page
 * size, because a row here averages half a megabyte and the client's ceilings
 * count rows, not bytes.
 *
 * Scoped by `forward_netbox_shard_keys`, the same parameter every
 * device-scoped bundled query uses. The job passes the device names it holds
 * identities for, so Forward returns configurations only for devices this
 * sync manages - an unscoped fetch would transfer configurations for the
 * whole collected estate and then discard the ones with nowhere to go.
 * Empty means unscoped, matching the convention in the other queries.
 *
 * Two sources, in this order:
 *
 * 1. The verbatim text of the device's CONFIG command - what Forward
 *    collected from the device. Almost every platform has one.
 * 2. When a device has NO config command, the configuration Forward parsed
 *    from it (`device.files.config`), rendered back to text. Cisco NX-OS
 *    switches in ACI mode, Cisco APIC controllers and F5 hypervisors hold
 *    their configuration only in this form. It is a tree of lines with
 *    children, at most six levels deep on every estate measured; on NX-OS the
 *    rendered text matches the collected text line for line. The tree is
 *    rendered here, inside NQE, because a single record field is capped at
 *    1,000,000 bytes and one such tree can be several megabytes as JSON,
 *    while its text is a fraction of that. A device with neither, or whose
 *    parsed configuration is empty, emits no row.
 *
 * Endpoints (network.endpoints - Cisco IMC/CIMC controllers, console servers
 * and other SNMP/CLI-profiled devices) are included when Forward collected a
 * configuration-style CLI command from them (`show run*`, `show config*`,
 * anything containing `running-config` or `current-configuration`); their
 * responses are joined into one file. Endpoints collected only over SNMP or
 * HTTP - the common case, including every Cisco IMC seen so far - hold no
 * configuration text in Forward and emit no row. An estate with no endpoints
 * at all simply gets no endpoint rows; nothing here requires them.
 *
 * The name emitted is the FORWARD device or endpoint name. Mapping to a NetBox device -
 * including any aliasing - happens in the job via ForwardDeviceIdentity,
 * which is why this query needs no alias variant.
 *
 * Forward strips collected credentials from these responses; hashed secrets
 * in the configuration text itself (for example `enable secret 9 ...`)
 * remain, as they do in any configuration backup.
 */

device_rows(forward_netbox_shard_keys: List<String>) =
  foreach device in network.devices
  where isEmpty(forward_netbox_shard_keys) || device.name in forward_netbox_shard_keys
  let collected = (foreach command in device.outputs.commands
    where command.commandType == CommandType.CONFIG
    select command.response)
  let rendered = join("\n",
    foreach a in device.files.config select
      "" + a.text +
      join("", foreach b in a.children select
        "\n" + "  " + b.text +
        join("", foreach c in b.children select
          "\n" + "    " + c.text +
          join("", foreach d in c.children select
            "\n" + "      " + d.text +
            join("", foreach e in d.children select
              "\n" + "        " + e.text +
              join("", foreach f in e.children select
                "\n" + "          " + f.text +
                join("", foreach z in f.children select "\n          [deeper configuration lines omitted]")))))))
  foreach text in (if isEmpty(collected) then [rendered] else collected)
  where text != ""
  select {
    name: device.name,
    config: text
  };
endpoint_rows(forward_netbox_shard_keys: List<String>) =
  foreach endpoint in network.endpoints
  where isEmpty(forward_netbox_shard_keys) || endpoint.name in forward_netbox_shard_keys
  let text = join("\n",
    foreach cli in endpoint.cliCommandResponses
    where matches(toLowerCase(cli.command), "*running-config*")
       || matches(toLowerCase(cli.command), "show run*")
       || matches(toLowerCase(cli.command), "show config*")
       || matches(toLowerCase(cli.command), "*current-configuration*")
    select cli.response)
  where text != ""
  select {
    name: endpoint.name,
    config: text
  };
@query
f(forward_netbox_shard_keys: List<String>) =
foreach row in device_rows(forward_netbox_shard_keys) + endpoint_rows(forward_netbox_shard_keys)
select row;
