/**
 * @intent Forward ACI Contracts
 * @description Discovers ACI contracts from the APIC `moquery -c vzBrCP` custom command.
 */

import "netbox_utilities";

contractRegex = re`(?:^|\R)#\s+vz\.BrCP\s*\R(?:\s*[^\r\n]*\R)*?\s*dn\s*:\s*uni/tn-(?<tenant_name>[^/\s]+)/brc-(?<name>[^\r\n/]+)\R(?:\s*[^\r\n]*\R)*?\s*prio\s*:\s*(?<prio>\S+)\R(?:\s*[^\r\n]*\R)*?\s*scope\s*:\s*(?<scope>\S+)\R(?:\s*[^\r\n]*\R)*?\s*targetDscp\s*:\s*(?<target_dscp>\S+)`;
aciFabricName(device) =
  if isPresent(device.locationName) && length(device.locationName) > 0
  then slugify(toLowerCase(device.locationName))
  else "forward-aci-fabric";

@query
f(forward_netbox_shard_keys: List<String>) =
foreach device in network.devices
where device.snapshotInfo.result == DeviceSnapshotResult.completed
where device.platform.vendor != Vendor.FORWARD_CUSTOM
foreach command in device.outputs.commands
where command.commandType == CommandType.CUSTOM
where matches(toLowerCase(command.commandText), "moquery -c vzbrcp*")
foreach contract_match in regexMatches(command.response, contractRegex)
let contract = contract_match.data
let fabric_name = aciFabricName(device)
where isEmpty(forward_netbox_shard_keys)
  || fabric_name in forward_netbox_shard_keys
  || contract.tenant_name in forward_netbox_shard_keys
  || contract.name in forward_netbox_shard_keys
select distinct {
  fabric_name: fabric_name,
  tenant_name: contract.tenant_name,
  name: contract.name,
  scope: contract.scope,
  qos_class: contract.prio,
  target_dscp: contract.target_dscp,
  description: "Forward observed ACI contract"
};
