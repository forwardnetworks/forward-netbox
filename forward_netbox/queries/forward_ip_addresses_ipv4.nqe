/**
 * @intent Forward IPv4 IP Addresses (plus optional SNMP endpoints)
 * @description Raw NQE for NetBox IPv4 address rows derived from Forward interface L3 state.
 * When sync_endpoints is true, the same SNMP endpoints forward_devices.nqe emits as
 * device rows also get one row per ipAddrTable entry, as a host (/32) address.
 */

subinterface_ipv4(forward_netbox_shard_keys: List<String>) =
  foreach device in network.devices
  where device.snapshotInfo.result == DeviceSnapshotResult.completed
  where device.platform.vendor != Vendor.FORWARD_CUSTOM
  where isEmpty(forward_netbox_shard_keys) || device.name in forward_netbox_shard_keys
  foreach interface in device.interfaces
  foreach subinterface in interface.subinterfaces
  foreach address in subinterface.ipv4.addresses
  let subnet = ipSubnet(address.ip, address.prefixLength)
  where address.prefixLength >= 31 || address.ip != networkAddress(subnet)
  where address.prefixLength >= 31 || address.ip != broadcastAddress(subnet)
  select {
    device: device.name,
    interface: interface.name,
    vrf: if isPresent(subinterface.networkInstanceName)
      then if subinterface.networkInstanceName != "default" then subinterface.networkInstanceName else null : String
      else null : String,
    address: subnet,
    host_ip: address.ip,
    prefix_length: address.prefixLength,
    status: "active"
  };

bridge_ipv4(forward_netbox_shard_keys: List<String>) =
  foreach device in network.devices
  where device.snapshotInfo.result == DeviceSnapshotResult.completed
  where device.platform.vendor != Vendor.FORWARD_CUSTOM
  where isEmpty(forward_netbox_shard_keys) || device.name in forward_netbox_shard_keys
  foreach interface in device.interfaces
  where isPresent(interface.bridge?.ipv4?.addresses)
  foreach address in interface.bridge.ipv4.addresses
  let subnet = ipSubnet(address.ip, address.prefixLength)
  where address.prefixLength >= 31 || address.ip != networkAddress(subnet)
  where address.prefixLength >= 31 || address.ip != broadcastAddress(subnet)
  select {
    device: device.name,
    interface: interface.name,
    vrf: if isPresent(interface.bridge.networkInstanceName)
      then if interface.bridge.networkInstanceName != "default" then interface.bridge.networkInstanceName else null : String
      else null : String,
    address: subnet,
    host_ip: address.ip,
    prefix_length: address.prefixLength,
    status: "active"
  };

tunnel_ipv4(forward_netbox_shard_keys: List<String>) =
  foreach device in network.devices
  where device.snapshotInfo.result == DeviceSnapshotResult.completed
  where device.platform.vendor != Vendor.FORWARD_CUSTOM
  where isEmpty(forward_netbox_shard_keys) || device.name in forward_netbox_shard_keys
  foreach interface in device.interfaces
  where isPresent(interface.tunnel?.ipv4?.addresses)
  foreach address in interface.tunnel.ipv4.addresses
  let subnet = ipSubnet(address.ip, address.prefixLength)
  where address.prefixLength >= 31 || address.ip != networkAddress(subnet)
  where address.prefixLength >= 31 || address.ip != broadcastAddress(subnet)
  select {
    device: device.name,
    interface: interface.name,
    vrf: if isPresent(interface.tunnel.networkInstanceName)
      then if interface.tunnel.networkInstanceName != "default" then interface.tunnel.networkInstanceName else null : String
      else null : String,
    address: subnet,
    host_ip: address.ip,
    prefix_length: address.prefixLength,
    status: "active"
  };

routed_vlan_ipv4(forward_netbox_shard_keys: List<String>) =
  foreach device in network.devices
  where device.snapshotInfo.result == DeviceSnapshotResult.completed
  where device.platform.vendor != Vendor.FORWARD_CUSTOM
  where isEmpty(forward_netbox_shard_keys) || device.name in forward_netbox_shard_keys
  foreach interface in device.interfaces
  where isPresent(interface.routedVlan?.ipv4?.addresses)
  foreach address in interface.routedVlan.ipv4.addresses
  let subnet = ipSubnet(address.ip, address.prefixLength)
  where address.prefixLength >= 31 || address.ip != networkAddress(subnet)
  where address.prefixLength >= 31 || address.ip != broadcastAddress(subnet)
  select {
    device: device.name,
    interface: interface.name,
    vrf: if isPresent(interface.routedVlan.networkInstanceName)
      then if interface.routedVlan.networkInstanceName != "default" then interface.routedVlan.networkInstanceName else null : String
      else null : String,
    address: subnet,
    host_ip: address.ip,
    prefix_length: address.prefixLength,
    status: "active"
  };

candidate_rows(forward_netbox_shard_keys: List<String>) =
  foreach row in (
  subinterface_ipv4(forward_netbox_shard_keys) + bridge_ipv4(forward_netbox_shard_keys)
    + tunnel_ipv4(forward_netbox_shard_keys) + routed_vlan_ipv4(forward_netbox_shard_keys)
)
  select distinct row;

global_candidate_rows(forward_netbox_shard_keys: List<String>) =
  foreach row in candidate_rows(forward_netbox_shard_keys)
  where !isPresent(row.vrf)
  select row;

global_rows(forward_netbox_shard_keys: List<String>) =
  foreach row in global_candidate_rows(forward_netbox_shard_keys)
  group row as grouped_rows by row.host_ip as host_ip
  let chosen_prefix_length = max(foreach candidate in grouped_rows
    select candidate.prefix_length)
  let chosen_device = min(foreach candidate in grouped_rows
    where candidate.prefix_length == chosen_prefix_length
    select candidate.device)
  let chosen_interface = min(foreach candidate in grouped_rows
    where candidate.prefix_length == chosen_prefix_length
      && candidate.device == chosen_device
    select candidate.interface)
  select {
    device: chosen_device,
    interface: chosen_interface,
    vrf: null : String,
    address: ipSubnet(host_ip, chosen_prefix_length),
    status: "active"
  };

vrf_candidate_rows(forward_netbox_shard_keys: List<String>) =
  foreach row in candidate_rows(forward_netbox_shard_keys)
  where isPresent(row.vrf)
  select row;

vrf_rows(forward_netbox_shard_keys: List<String>) =
  foreach row in vrf_candidate_rows(forward_netbox_shard_keys)
  group row as grouped_rows by {address: row.address, vrf: row.vrf} as key
  let chosen_device = min(foreach candidate in grouped_rows
    select candidate.device)
  let chosen_interface = min(foreach candidate in grouped_rows
    where candidate.device == chosen_device
    select candidate.interface)
  select {
    device: chosen_device,
    interface: chosen_interface,
    vrf: key.vrf,
    address: key.address,
    status: "active"
  };

// SNMP endpoints (opt-in): one row per ipAddrTable entry, for the same
// endpoints forward_devices.nqe emits as device rows. The eligibility gate
// below is byte-identical to forward_devices.nqe's endpoint branch through
// the "isConsoleServer" gate, and to forward_interfaces.nqe's
// endpoint_interfaces - see test_endpoint_ipv4_gate_matches_device_gate.
// Always a /32 host address: SNMP's ipAddrTable carries no mask this query
// can derive a real subnet from, and a host address is the honest default
// for a directly observed management address (this pipeline already treats
// /31 and /32 as single-host addresses elsewhere - see the >= 31 checks
// above). Not folded into global_rows/vrf_rows: those group by host_ip to
// resolve conflicts BETWEEN a device's own subinterfaces, which does not
// apply here - an endpoint's ipAddrTable is already its own single source.
endpoint_ipv4(forward_netbox_shard_keys: List<String>, sync_endpoints: Bool, sync_generic_endpoints: Bool, scope_endpoints_by_include_tags: Bool, device_tag_include_tags: List<String>, device_tag_include_match: String, device_tag_exclude_tags: List<String>) =
  foreach endpoint in network.endpoints
  where sync_endpoints
  where !isEmpty(endpoint.snmpOutputs)
  where isEmpty(device_tag_exclude_tags)
    || !any(foreach tag in device_tag_exclude_tags select tag in endpoint.tagNames)
  where !scope_endpoints_by_include_tags
    || isEmpty(device_tag_include_tags)
    || (device_tag_include_match == "all"
      && !any(foreach tag in device_tag_include_tags select !(tag in endpoint.tagNames)))
    || (device_tag_include_match != "all"
      && any(foreach tag in device_tag_include_tags select tag in endpoint.tagNames))
  let sysDescrOpt = max(foreach o in endpoint.snmpOutputs where o.requestedOid == "1.3.6.1.2.1.1.1" select max(foreach e in o.rawOidEntries select e.rawValue))
  let sysObjIdOpt = max(foreach o in endpoint.snmpOutputs where o.requestedOid == "1.3.6.1.2.1.1.2" select max(foreach e in o.rawOidEntries select e.rawValue))
  let hasDescr = isPresent(sysDescrOpt) && sysDescrOpt != ""
  let sysDescr = if hasDescr then sysDescrOpt else "SNMP Endpoint"
  // Collapse embedded newlines/tabs/whitespace runs to a single space so a
  // multiline sysDescr (IOS banners etc.) can't leak junk into the platform
  // name or the 100-char clamp.
  let sysDescrClean = replaceRegexMatches(sysDescr, re`\s+`, " ")
  let sysObjId = if isPresent(sysObjIdOpt) then sysObjIdOpt else ""
  let sdLower = toLowerCase(sysDescrClean)
  let endpointNameLower = toLowerCase(toString(endpoint.name))
  let endpointProfileName = toLowerCase(toString(endpoint.profileName))
  let isCimc = matches(endpointNameLower, "*cimc*")
    || matches(endpointProfileName, "*cimc*")
    || matches(sdLower, "*cisco integrated management controller*")
  where !isCimc
  // Avocent overlay: enterprise OIDs 10418 (Avocent/Vertiv) and 2925 (Cyclades,
  // pre-acquisition), product-name signatures for units that report no
  // distinct sysObjectID (Cyclades/AlterPath fold into Avocent), and the
  // profile name Forward already assigned - some units answer neither
  // sysDescr nor sysObjectID at all, and the profile is the only identity
  // signal left.
  let isAvocent = matches(sysObjId, "1.3.6.1.4.1.10418.*")
    || matches(sysObjId, "1.3.6.1.4.1.2925.*")
    || matches(sdLower, "*avocent*")
    || matches(sdLower, "*cyclades*")
    || matches(sdLower, "*alterpath*")
    || matches(endpointProfileName, "*avocent*")
    || matches(endpointProfileName, "*cyclades*")
  // Opengear console servers use enterprise OID 25049. Their sysDescr embeds
  // kernel, firmware, build hash, and date data, so treating the full value as
  // DeviceType.model creates a new type after every software upgrade.
  let isOpengear = matches(sysObjId, "1.3.6.1.4.1.25049.*")
    || matches(sdLower, "*opengear*")
    || matches(endpointProfileName, "*opengear*")
  let isConsoleServer = isAvocent || isOpengear
  where sync_generic_endpoints || isConsoleServer
  // ipAdEntIfIndex's OID suffix IS the dotted IPv4 address (ipAddrTable is
  // indexed by the address itself); its rawValue is the owning ifIndex.
  foreach ifIndexOutput in endpoint.snmpOutputs
  where ifIndexOutput.requestedOid == "1.3.6.1.2.1.4.20"
  foreach ifIndexEntry in ifIndexOutput.rawOidEntries
  where matches(ifIndexEntry.oid, "1.3.6.1.2.1.4.20.1.2.*")
  let hostIpRaw = substring(ifIndexEntry.oid, 21, 999)
  where !isEmpty(regexMatches(hostIpRaw, re`^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$`))
  let ifIndexValue = ifIndexEntry.rawValue
  let ifDescrOpt = max(
    foreach ifOutput in endpoint.snmpOutputs
    where ifOutput.requestedOid == "1.3.6.1.2.1.2"
    select max(
      foreach descrEntry in ifOutput.rawOidEntries
      where descrEntry.oid == "1.3.6.1.2.1.2.2.1.2." + ifIndexValue
      select descrEntry.rawValue
    )
  )
  let ifNameOpt = max(
    foreach nameOutput in endpoint.snmpOutputs
    where nameOutput.requestedOid == "1.3.6.1.2.1.31.1.1.1"
    select max(
      foreach nameEntry in nameOutput.rawOidEntries
      where nameEntry.oid == "1.3.6.1.2.1.31.1.1.1.1." + ifIndexValue
      select nameEntry.rawValue
    )
  )
  let ifNameRaw = if isPresent(ifNameOpt) && ifNameOpt != "" then ifNameOpt
    else if isPresent(ifDescrOpt) && ifDescrOpt != "" then ifDescrOpt
    else null : String
  let ifName = if isPresent(ifNameRaw) && ifNameRaw != "" then ifNameRaw else "if" + ifIndexValue
  select {
    device: endpoint.name,
    interface: ifName,
    vrf: null : String,
    address: ipSubnet(ipAddress(hostIpRaw), 32),
    status: "active"
  };

@query
f(forward_netbox_shard_keys: List<String>, sync_endpoints: Bool, sync_generic_endpoints: Bool, scope_endpoints_by_include_tags: Bool, device_tag_include_tags: List<String>, device_tag_include_match: String, device_tag_exclude_tags: List<String>) =
foreach row in (
  (
    foreach row in (global_rows(forward_netbox_shard_keys) + vrf_rows(forward_netbox_shard_keys))
    select distinct row
  )
  + endpoint_ipv4(forward_netbox_shard_keys, sync_endpoints, sync_generic_endpoints, scope_endpoints_by_include_tags, device_tag_include_tags, device_tag_include_match, device_tag_exclude_tags)
)
select row;
