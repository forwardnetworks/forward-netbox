/**
 * @intent Forward ACI Subject Filters
 * @description Discovers the filters attached to ACI contract subjects, with direction, action and priority, from the APIC `moquery -c vzRsSubjFiltAtt` custom command.
 */

import "netbox_utilities";

// One block per attachment; the attribute lines are read separately so a
// controller that omits `action` or `priorityOverride` still yields the row.
attachmentBlockRegex = re`(?:^|\R)#\s+vz\.RsSubjFiltAtt\s*\R(?<body>(?:[ \t]*[^#\s][^\r\n]*\R?)+)`;
dnRegex = re`(?:^|\R)\s*dn\s*:\s*uni/tn-(?<tenant_name>[^/\s]+)/brc-(?<contract_name>[^/\s]+)/subj-(?<subject_name>[^/\s]+)(?:/(?<terminal>intmnl|outtmnl))?/rssubjFiltAtt-(?<filter_name>\S+)`;
actionRegex = re`(?:^|\R)\s*action\s*:\s*(?<action>\S+)`;
priorityRegex = re`(?:^|\R)\s*priorityOverride\s*:\s*(?<priority>\S+)`;
aciFabricName(device) =
  if isPresent(device.locationName) && length(device.locationName) > 0
  then slugify(toLowerCase(device.locationName))
  else "forward-aci-fabric";
firstOr(values, fallback) = if isEmpty(values) then fallback else min(values);
direction(terminal) =
  if !isPresent(terminal) then "both"
  else if terminal == "intmnl" then "in"
  else "out";

@query
f(forward_netbox_shard_keys: List<String>) =
foreach device in network.devices
where device.snapshotInfo.result == DeviceSnapshotResult.completed
where device.platform.vendor != Vendor.FORWARD_CUSTOM
foreach command in device.outputs.commands
where command.commandType == CommandType.CUSTOM
where matches(toLowerCase(command.commandText), "moquery -c vzrssubjfiltatt*")
foreach block in regexMatches(command.response, attachmentBlockRegex)
let body = block.data.body
foreach dn in regexMatches(body, dnRegex)
let attachment = dn.data
let fabric_name = aciFabricName(device)
where isEmpty(forward_netbox_shard_keys)
  || fabric_name in forward_netbox_shard_keys
  || attachment.tenant_name in forward_netbox_shard_keys
  || attachment.contract_name in forward_netbox_shard_keys
select distinct {
  fabric_name: fabric_name,
  tenant_name: attachment.tenant_name,
  contract_name: attachment.contract_name,
  subject_name: attachment.subject_name,
  filter_name: attachment.filter_name,
  direction: direction(attachment.terminal),
  action: firstOr(foreach m in regexMatches(body, actionRegex) select m.data.action, "permit"),
  priority: firstOr(foreach m in regexMatches(body, priorityRegex) select m.data.priority, "default"),
  description: "Forward observed ACI subject filter"
};
