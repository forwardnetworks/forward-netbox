/**
 * @intent Device interfaces collected by Forward (plus optional SNMP endpoints)
 * @description It provides a list of device interfaces collected by Forward to be added
 * in NetBox using POST and PATCH requests to the /api/dcim/interfaces/ REST API endpoint.
 * When sync_endpoints is true, the same SNMP endpoints forward_devices.nqe emits as
 * device rows also get one interface row per ifTable ifIndex, named from ifXTable
 * ifName where present, else ifTable ifDescr.
 */

ethernet_by_speed_mbps = [
  { mbps: 10, type: "other" },
  { mbps: 100, type: "100base-tx" },
  { mbps: 1000, type: "1000base-t" },
  { mbps: 2500, type: "2.5gbase-t" },
  { mbps: 5000, type: "5gbase-t" },
  { mbps: 10000, type: "10gbase-t" },
  { mbps: 25000, type: "25gbase-x-sfp28" },
  { mbps: 40000, type: "40gbase-x-qsfpp" },
  { mbps: 50000, type: "50gbase-x-sfp56" },
  { mbps: 100000, type: "100gbase-x-qsfp28" }
];

device_interfaces(forward_netbox_shard_keys: List<String>) =
foreach device in network.devices
where device.snapshotInfo.result == DeviceSnapshotResult.completed
where device.platform.vendor != Vendor.FORWARD_CUSTOM
where isEmpty(forward_netbox_shard_keys) || device.name in forward_netbox_shard_keys
foreach interface in device.interfaces
  let is_ethernet = interface.interfaceType == IfaceType.IF_ETHERNET
  let speed_mbps = if is_ethernet then interface.ethernet.speedMbps else null : Integer
  let interface_type = max(foreach profile in ethernet_by_speed_mbps
    where profile.mbps == speed_mbps
    select profile.type)
  let netbox_type =
    if is_ethernet
      then if isPresent(interface_type) then interface_type else "other"
    else if interface.interfaceType == IfaceType.IF_LOOPBACK
      then "virtual"
    else if interface.interfaceType == IfaceType.IF_AGGREGATE
      then "lag"
    else "other"
  let vlan_mode =
    if isPresent(interface.ethernet?.switchedVlan?.interfaceMode)
      then if interface.ethernet.switchedVlan.interfaceMode == VlanModeType.ACCESS then "access"
      else if interface.ethernet.switchedVlan.interfaceMode == VlanModeType.TRUNK then "tagged"
      else null : String
    else null : String
  let untagged_vlan =
    if vlan_mode == "access" && isPresent(interface.ethernet.switchedVlan.accessVlan)
      then interface.ethernet.switchedVlan.accessVlan
    else if vlan_mode == "tagged" && isPresent(interface.ethernet.switchedVlan.nativeVlan)
      then interface.ethernet.switchedVlan.nativeVlan
    else null : Integer
  select {
    device: device.name,
    name: interface.name,
    type: netbox_type,
    lag: if is_ethernet && isPresent(interface.ethernet.aggregateId) then interface.ethernet.aggregateId else null : String,
    mode: vlan_mode,
    untagged_vlan: untagged_vlan,
    enabled: interface.operStatus == OperStatus.UP,
    mtu: interface.mtu,
    description:
      if isPresent(interface.description) && interface.description != ""
        then interface.description
      else null : String,
    speed: if isPresent(speed_mbps) then speed_mbps * 1000 else null : Integer
  };

// SNMP endpoints (opt-in): one row per ifTable ifIndex, for the same endpoints
// forward_devices.nqe emits as device rows. The eligibility gate below (tag
// scope, CIMC exclusion, Avocent/Opengear console-server detection) is
// byte-identical to forward_devices.nqe's endpoint branch through the
// "isConsoleServer" gate - see test_endpoint_interface_gate_matches_device_gate.
// An interface row whose device was never created (gate mismatch) is a
// dependency-skip in the apply engine, not a corruption, but the two gates
// must still agree or endpoints silently lose their interfaces.
endpoint_interfaces(forward_netbox_shard_keys: List<String>, sync_endpoints: Bool, sync_generic_endpoints: Bool, scope_endpoints_by_include_tags: Bool, device_tag_include_tags: List<String>, device_tag_include_match: String, device_tag_exclude_tags: List<String>) =
  foreach endpoint in network.endpoints
  where sync_endpoints
  where !isEmpty(endpoint.snmpOutputs)
  where isEmpty(device_tag_exclude_tags)
    || !any(foreach tag in device_tag_exclude_tags select tag in endpoint.tagNames)
  where !scope_endpoints_by_include_tags
    || isEmpty(device_tag_include_tags)
    || (device_tag_include_match == "all"
      && !any(foreach tag in device_tag_include_tags select !(tag in endpoint.tagNames)))
    || (device_tag_include_match != "all"
      && any(foreach tag in device_tag_include_tags select tag in endpoint.tagNames))
  let sysDescrOpt = max(foreach o in endpoint.snmpOutputs where o.requestedOid == "1.3.6.1.2.1.1.1" select max(foreach e in o.rawOidEntries select e.rawValue))
  let sysObjIdOpt = max(foreach o in endpoint.snmpOutputs where o.requestedOid == "1.3.6.1.2.1.1.2" select max(foreach e in o.rawOidEntries select e.rawValue))
  let hasDescr = isPresent(sysDescrOpt) && sysDescrOpt != ""
  let sysDescr = if hasDescr then sysDescrOpt else "SNMP Endpoint"
  // Collapse embedded newlines/tabs/whitespace runs to a single space so a
  // multiline sysDescr (IOS banners etc.) can't leak junk into the platform
  // name or the 100-char clamp.
  let sysDescrClean = replaceRegexMatches(sysDescr, re`\s+`, " ")
  let sysObjId = if isPresent(sysObjIdOpt) then sysObjIdOpt else ""
  let sdLower = toLowerCase(sysDescrClean)
  let endpointNameLower = toLowerCase(toString(endpoint.name))
  let endpointProfileName = toLowerCase(toString(endpoint.profileName))
  let isCimc = matches(endpointNameLower, "*cimc*")
    || matches(endpointProfileName, "*cimc*")
    || matches(sdLower, "*cisco integrated management controller*")
  where !isCimc
  // Avocent overlay: enterprise OIDs 10418 (Avocent/Vertiv) and 2925 (Cyclades,
  // pre-acquisition), product-name signatures for units that report no
  // distinct sysObjectID (Cyclades/AlterPath fold into Avocent), and the
  // profile name Forward already assigned - some units answer neither
  // sysDescr nor sysObjectID at all, and the profile is the only identity
  // signal left.
  let isAvocent = matches(sysObjId, "1.3.6.1.4.1.10418.*")
    || matches(sysObjId, "1.3.6.1.4.1.2925.*")
    || matches(sdLower, "*avocent*")
    || matches(sdLower, "*cyclades*")
    || matches(sdLower, "*alterpath*")
    || matches(endpointProfileName, "*avocent*")
    || matches(endpointProfileName, "*cyclades*")
  // Opengear console servers use enterprise OID 25049. Their sysDescr embeds
  // kernel, firmware, build hash, and date data, so treating the full value as
  // DeviceType.model creates a new type after every software upgrade.
  let isOpengear = matches(sysObjId, "1.3.6.1.4.1.25049.*")
    || matches(sdLower, "*opengear*")
    || matches(endpointProfileName, "*opengear*")
  let isConsoleServer = isAvocent || isOpengear
  where sync_generic_endpoints || isConsoleServer
  // ifTable is universally present on anything answering SNMP at all;
  // ifDescr is the enumeration anchor (one row per ifIndex it reports).
  foreach ifOutput in endpoint.snmpOutputs
  where ifOutput.requestedOid == "1.3.6.1.2.1.2"
  foreach descrEntry in ifOutput.rawOidEntries
  where matches(descrEntry.oid, "1.3.6.1.2.1.2.2.1.2.*")
  let ifIndexSuffix = substring(descrEntry.oid, 20, 999)
  let ifDescr = descrEntry.rawValue
  // ifXTable ifName is a nicer, more modern name than ifDescr where the
  // device reports it; matched back to this ifIndex by the identical
  // trailing-index suffix every ifTable/ifXTable column shares.
  let ifNameOpt = max(
    foreach nameOutput in endpoint.snmpOutputs
    where nameOutput.requestedOid == "1.3.6.1.2.1.31.1.1.1"
    select max(
      foreach nameEntry in nameOutput.rawOidEntries
      where nameEntry.oid == "1.3.6.1.2.1.31.1.1.1.1." + ifIndexSuffix
      select nameEntry.rawValue
    )
  )
  let operStatusOpt = max(
    foreach opOutput in endpoint.snmpOutputs
    where opOutput.requestedOid == "1.3.6.1.2.1.2"
    select max(
      foreach opEntry in opOutput.rawOidEntries
      where opEntry.oid == "1.3.6.1.2.1.2.2.1.8." + ifIndexSuffix
      select opEntry.rawValue
    )
  )
  let ifNameRaw = if isPresent(ifNameOpt) && ifNameOpt != "" then ifNameOpt else ifDescr
  let ifName = if isPresent(ifNameRaw) && ifNameRaw != "" then ifNameRaw else "if" + ifIndexSuffix
  select {
    device: endpoint.name,
    name: ifName,
    type: "other",
    enabled: operStatusOpt == "1"
  };

@query
f(forward_netbox_shard_keys: List<String>, sync_endpoints: Bool, sync_generic_endpoints: Bool, scope_endpoints_by_include_tags: Bool, device_tag_include_tags: List<String>, device_tag_include_match: String, device_tag_exclude_tags: List<String>) =
foreach row in (
  device_interfaces(forward_netbox_shard_keys)
  + endpoint_interfaces(forward_netbox_shard_keys, sync_endpoints, sync_generic_endpoints, scope_endpoints_by_include_tags, device_tag_include_tags, device_tag_include_match, device_tag_exclude_tags)
)
select row;
